\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{myacronyms}[2026/07/04 I3C thesis acronyms]

\RequirePackage[acronym,toc]{glossaries}
\makeglossaries

% ---- Two-column style for DANH MỤC TỪ VIẾT TẮT ----
%  left  = abbreviation (narrow, left-aligned)
%  right = expansion (justified, wraps), with vertical gap between entries
\newlength{\acrotermwidth}
\setlength{\acrotermwidth}{0.27\linewidth}
\newglossarystyle{acrotwocol}{%
  \renewenvironment{theglossary}%
    {\begin{longtable}{@{}>{\raggedright\arraybackslash}p{\acrotermwidth}@{\hspace{0.02\linewidth}}p{0.67\linewidth}@{}}}%
    {\end{longtable}}%
  \renewcommand*{\glossaryheader}{}%
  \renewcommand*{\glsgroupheading}[1]{}%
  \renewcommand*{\glsgroupskip}{}%
  \renewcommand*{\glossentry}[2]{%
    \glstarget{##1}{\glossentryname{##1}} &
    \glossentrydesc{##1}\tabularnewline[1.1ex]%
  }%
  \renewcommand*{\subglossentry}[3]{%
    & \glossentrydesc{##2}\tabularnewline[1.1ex]%
  }%
}

